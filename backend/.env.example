# HTTP / WebSocket port
PORT=4000

# Postgres connection string (AWS RDS in production)
DATABASE_URL=postgres://textshare:textshare@localhost:5433/textshare
# Set to true when connecting to RDS over TLS
DATABASE_SSL=false

# Secret used to sign login tokens - use a long random value in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
